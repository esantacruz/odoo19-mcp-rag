# Paths relative to this project, never relative to the client's working directory.
ODOO_RAG_DATA_DIR=data
ODOO_RAG_EMBEDDING_PROVIDER=local
ODOO_RAG_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
ODOO_RAG_LOCAL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
ODOO_RAG_CHUNK_SIZE=800
ODOO_RAG_CHUNK_OVERLAP=150
ODOO_RAG_BATCH_SIZE=32
ODOO_RAG_TORCH_THREADS=4
ODOO_RAG_OFFLINE=true
# Explicit opt-in, never selected merely because an API key exists:
# ODOO_RAG_EMBEDDING_PROVIDER=openai
# ODOO_RAG_OPENAI_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
